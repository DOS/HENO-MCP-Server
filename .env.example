# ==============================================================================
# TINGEE MCP SERVER - CONFIGURATION
# ==============================================================================

# 1. Scoped Bearer Token cho DOS Agent gọi vào MCP Server này
# Sinh ngẫu nhiên bằng lệnh: openssl rand -hex 32
MCP_BEARER_TOKEN=your_mcp_bearer_token_here_random_hex_32

# 2. Tingee Master API Key (NẰM 100% TRÊN SERVER CỦA HENO - KHÔNG GỬI CHO DOS)
# Key dùng để gọi API Reset Loa của Tingee
TINGEE_API_KEY=your_tingee_api_key_for_reset_here
TINGEE_RESET_URL=https://open-api.tingee.vn/v1/device/reset-device

# 3. Tingee Speaker Status API Key (NẰM 100% TRÊN SERVER CỦA HENO)
# Key dùng để tra cứu trạng thái & hạn thuê bao loa (kiểm tra điều kiện 30 ngày)
TINGEE_SPEAKER_API_KEY=your_tingee_speaker_status_api_key_here
TINGEE_SPEAKER_STATUS_URL=https://open-api.tingee.vn/v1/partner/speakers/status

# 4. Cổng chạy server (mặc định 18070)
PORT=18070
